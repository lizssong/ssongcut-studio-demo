{
  "id": "./",
  "name": "쏭컷 AI 스튜디오",
  "short_name": "쏭컷",
  "description": "긴 영상은 AI가 요약해 자막 입힌 숏츠로, 사진·영상은 템플릿·전환·배경음악을 넣은 쇼츠·릴스로 만드는 위드AI솔루션 송민경(쏭리즈)의 쏭컷 AI 스튜디오",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#08080d",
  "theme_color": "#08080d",
  "categories": [
    "productivity",
    "photo",
    "education"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./?source=file",
      "accept": {
        "video/mp4": [
          ".mp4",
          ".m4v"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "video/webm": [
          ".webm"
        ],
        "video/x-matroska": [
          ".mkv"
        ]
      },
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "video",
          "accept": [
            "video/*",
            ".mp4",
            ".mov",
            ".webm",
            ".m4v",
            ".mkv"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "shortcuts": [
    {
      "name": "영상 올리기",
      "short_name": "영상 올리기",
      "url": "./?source=shortcut#upload",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "사진·영상 편집",
      "short_name": "사진·영상 편집",
      "url": "./studio.html?source=shortcut",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "공백 컷편집",
      "short_name": "공백 컷편집",
      "url": "./cut.html?source=shortcut",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}